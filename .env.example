# GEMINI_API_KEY: Optional - used for explaining already-flagged fraud findings.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.

# Supabase Authentication & PostgreSQL Configuration:
# Frontend public keys for Supabase Auth and database access.
# If left blank, the app runs in Local / Demo Auth mode.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."

# Backend-only Supabase Service Role Key (never exposed to frontend):
SUPABASE_SERVICE_ROLE_KEY=""

# Plaid Sandbox Integration (Optional):
# Prepare connection to Plaid Sandbox. The application works out-of-the-box
# with CSV and synthetic data if these are left blank.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Server Port
PORT=3000
